<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.yumyum.domain.user.repository.userRole.UserRoleMapper">

    <select id="findAll" resultType="UserRoleVO">
        SELECT *
        FROM user_role
    </select>

    <select id="findById" resultType="UserRoleVO">
        SELECT *
        FROM user_role
        WHERE user_role_id = #{userRoleId}
    </select>

    <insert id="insert" parameterType="UserRoleVO">
        INSERT INTO user_role (
            user_role_name
        ) VALUES (
            #{userRoleName}
        )
    </insert>

    <update id="updateById" parameterType="UserRoleVO">
        UPDATE user_role
        SET user_role_name = #{userRoleName}
        WHERE user_role_id = #{userRoleId}
    </update>

    <delete id="deleteById">
        DELETE FROM user_role
        WHERE user_role_id = #{userRoleId}
    </delete>

    <select id="count">
        SELECT COUNT(*)
        FROM user_role
    </select>

    <select id="maxId">
        SELECT MAX(user_role_id)
        FROM user_role
    </select>

    <select id="findByUserRoleName" parameterType="String">
        SELECT *
        FROM user_role
        WHERE user_role_name = #{userRoleName}
    </select>

</mapper>
